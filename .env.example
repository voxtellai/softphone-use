# Copy to .env.local (or .env) in the directory you run softphone-use from.

# The SIP device to register as. Required.
SOFTPHONE_SIP_USER=1001
SOFTPHONE_SIP_PASSWORD=
SOFTPHONE_SIP_DOMAIN=pbx.example.com

# Where to send SIP. Defaults to the domain.
# SOFTPHONE_SIP_PROXY=sbc.example.com:5060
# tcp (default) or udp.
# SOFTPHONE_SIP_TRANSPORT=tcp

# Agent mode: an xAI realtime voice agent answers or places the call.
# XAI_API_KEY=
# SOFTPHONE_XAI_MODEL=grok-voice-think-fast-2.0
# SOFTPHONE_XAI_VOICE=ara

# Answer incoming calls by themselves: manual (default), human, ai, echo, tone or silent.
# SOFTPHONE_AUTO_ANSWER=manual
# SOFTPHONE_AUTO_ANSWER_AFTER=2s
# SOFTPHONE_RING_TIMEOUT=60s

# The control API, and where calls are saved.
# SOFTPHONE_HTTP_ADDR=127.0.0.1:7071
# SOFTPHONE_DATA_DIR=recordings
